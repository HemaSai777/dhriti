# ==============================================================================
# SAHAYA Configuration Environment Variables
# ==============================================================================

# LLM Provider Configuration (gemini, openai, ollama, mock)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Embeddings Model (sentence-transformers / local)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Safety & Verification Gate Thresholds
# Standard queries: 0.75 | Sensitive queries (Claims, Legal By-laws, Grievances): 0.85
CONFIDENCE_THRESHOLD=0.75
SENSITIVE_CONFIDENCE_THRESHOLD=0.85

# Database URL (SQLite default for hackathon MVP)
DATABASE_URL=sqlite:///./sahaya.db

# Retrieval Configuration
TOP_K_RETRIEVAL=5
